POSTGRES_DB=sdistdb
POSTGRES_USER=sdist_app
POSTGRES_PASSWORD=change-me

# --- Usado por docker-compose.production.yml (app corre containerizada) ---
# OJO: no definir aca QUARKUS_DATASOURCE_* -- Quarkus mapea esas variables de
# entorno directo a su config SIN importar el perfil (%dev/%prod), y pisarian
# la config de desarrollo si este mismo .env se usa en la maquina local.
APP_HTTP_PORT=8080
CORS_ORIGINS=https://tu-dominio-real.com

# --- Usado por docker-compose.dev.yml + application.properties (%dev) ---
# cuando corres "mvn quarkus:dev" en el host contra el Postgres de desarrollo
DB_PORT=5432
